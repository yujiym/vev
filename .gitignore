# SPDX-License-Identifier: AGPL-3.0-or-later
# Isolated worktrees for plan execution
.worktrees/
# Subagent-driven development workspace (ledgers, briefs, reports, review packages)
.superpowers/sdd/
node_modules/
.svelte-kit/
build/
dist/
.wrangler/
.dev.vars
.env
.env.*
!.env.example
# apps/web/.env carries non-secret PUBLIC_* defaults (the AGPL source link's
# SOURCE_URL/commit, §14.1) rather than credentials, so it is tracked like any
# other source file, unlike apps/api's .dev.vars.
!apps/web/.env
# Local verification captures: screenshots and recordings, never committed
artifacts/
*.log
