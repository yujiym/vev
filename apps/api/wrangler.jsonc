{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vev",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // The built SPA is served by this Worker: one deployed Worker, and the same
  // artifact runs at a venue (§3, §15.3). `run_worker_first` keeps /api/* from
  // being swallowed by the SPA fallback.
  "assets": {
    "directory": "../web/build",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // SOURCE_URL is the AGPL §13 source offer (§14.1). A self-hoster who modifies
  // vev points this at their own fork.
  "vars": {
    "GIT_COMMIT": "dev",
    "SOURCE_URL": "https://github.com/oboroxyz/vev",
    "VEV_MODE": "cloud",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vev",
      // Filled by `pnpm setup` (M12). Until then, only `--local` works.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    // `--env local` is local mode (§15.3) and never deploys: it takes no routes
    // and no custom domain.
    "local": {
      // Verified empirically (Task 6): `assets` IS inherited from the top
      // level by a named environment, but `vars` and `d1_databases` are NOT
      // (Task 4 hit the same for `d1_databases`) — wrangler even warns at
      // startup if `vars` is missing here. So only `vars` and `d1_databases`
      // are repeated; `assets` is intentionally omitted.
      "vars": {
        "GIT_COMMIT": "dev",
        "SOURCE_URL": "https://github.com/oboroxyz/vev",
        "VEV_MODE": "local",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vev",
          // Filled by `pnpm setup` (M12). Until then, only `--local` works.
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
