{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vev",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // SOURCE_URL is the AGPL §13 source offer (§14.1). A self-hoster who modifies
  // vev points this at their own fork.
  "vars": {
    "SOURCE_URL": "https://github.com/oboroxyz/vev",
    "VEV_MODE": "cloud",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vev",
      // Filled by `pnpm setup` (M12). Until then, only `--local` works.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    // `--env local` is local mode (§15.3) and never deploys: it takes no routes
    // and no custom domain.
    "local": {
      "vars": {
        "SOURCE_URL": "https://github.com/oboroxyz/vev",
        "VEV_MODE": "local",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vev",
          // Filled by `pnpm setup` (M12). Until then, only `--local` works.
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
