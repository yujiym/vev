{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vev",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // The built SPA is served by this Worker: one deployed Worker, and the same
  // artifact runs at a venue (§3, §15.3). `run_worker_first` keeps /api/* from
  // being swallowed by the SPA fallback. `pnpm live` builds `../web/build`
  // first, so this directory always exists there. `pnpm dev` does NOT build it
  // — it overrides this at the CLI with `--assets ./dev-assets` (verified: the
  // flag replaces `directory` while `not_found_handling` and
  // `run_worker_first` from this config still apply), so a clean clone with no
  // build never fails to start, and 8787 during `pnpm dev` visibly says "this
  // isn't the app" instead of silently serving a stale build. The real dev SPA
  // is Vite's, on :5173 (see apps/web/vite.config.ts).
  //
  // `/media/*` (Task 4, `src/routes/media.ts`) needs the same treatment: it is
  // the Worker's own route, not a static asset, and with no matching file
  // under `../web/build` the SPA fallback would otherwise swallow it and
  // return `index.html` instead of a thumbnail (or a real 404).
  "assets": {
    "directory": "../web/build",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"],
  },
  // SOURCE_URL is the AGPL §13 source offer (§14.1). ACCESS_TEAM_DOMAIN and
  // ACCESS_AUD back the §13 Access-assertion presence check (see src/access.ts).
  // Not exercised by the presence check itself (it only checks the header
  // exists), but kept here — not hardcoded in code — for the day full JWT
  // verification lands. ACCESS_TEAM_DOMAIN is confirmed: the live preview's
  // own `/.well-known/cloudflare-access-protected-resource/studio` returns it
  // directly as `team_domain`. ACCESS_AUD is NOT independently confirmed —
  // it is the `kid` query param on the Access login redirect, very likely
  // the application's audience tag but not cross-checked against the
  // Cloudflare dashboard (the actual source of truth); see the runbook's
  // Access gotcha before the stretch relies on it.
  // A self-hoster who modifies vev points SOURCE_URL at their own fork.
  "vars": {
    "ACCESS_AUD": "2751fc6207bcfd7f632e739f25ffd5a12a8325b4fcd8825fb9cbeac9bdf01ffd",
    "ACCESS_TEAM_DOMAIN": "710gs.cloudflareaccess.com",
    "GIT_COMMIT": "dev",
    "SOURCE_URL": "https://github.com/yujiym/vev",
    "VEV_MODE": "cloud",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vev",
      // Filled by `pnpm setup` (M12). Until then, only `--local` works.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // The bucket and both queues already exist (created directly, ahead of
  // `pnpm setup` from M12). Same inheritance rule as `vars` / `d1_databases`:
  // a named environment gets none of this for free, so it is repeated under
  // `env.preview` below with the `-preview` resources. Not repeated under
  // `env.local`'s queue — INGEST is optional and pointless offline (§15.3) —
  // but MEDIA IS repeated there: unlike AI/VECTORIZE/INGEST, R2 has a local
  // miniflare implementation, and `Env.MEDIA` is required, not optional, so
  // `--env local` (which `pnpm live`, `pnpm test` and `pnpm dev` all use)
  // needs a binding too. The bucket name there is irrelevant — miniflare
  // emulates R2 locally regardless of which real bucket the name matches —
  // so it reuses the top-level name rather than inventing a third bucket.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "vev-media" }],
  "queues": {
    "producers": [{ "binding": "INGEST", "queue": "vev-ingest" }],
    // max_batch_size: 1 — annotation is one clip at a time, not a bulk job.
    // No dead-letter queue: the consumer (Task 5) marks a clip `failed` and
    // acks rather than retrying forever, so one is not needed.
    "consumers": [{ "queue": "vev-ingest", "max_batch_size": 1, "max_retries": 2 }],
  },
  "env": {
    // `--env local` is local mode (§15.3) and never deploys: it takes no routes
    // and no custom domain.
    "local": {
      // Verified empirically: `assets` IS inherited from the top level by a
      // named environment, but `vars` and `d1_databases` are NOT — removing
      // either block here (with wrangler dev --env local) produced a startup
      // warning and a missing binding. So only `vars` and `d1_databases` are
      // repeated; `assets` is intentionally omitted.
      // ACCESS_TEAM_DOMAIN / ACCESS_AUD are required on `Env`, so a sentinel
      // is set here for type honesty — local mode has no Cloudflare Access
      // (§15.3) and the presence check in src/access.ts is disabled whenever
      // VEV_MODE is 'local', so nothing ever actually reads these values.
      "vars": {
        "ACCESS_AUD": "unused-in-local-mode",
        "ACCESS_TEAM_DOMAIN": "unused-in-local-mode",
        "GIT_COMMIT": "dev",
        "SOURCE_URL": "https://github.com/yujiym/vev",
        "VEV_MODE": "local",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vev",
          // Filled by `pnpm setup` (M12). Until then, only `--local` works.
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
      // See the top-level `r2_buckets` comment: required binding, R2 works
      // locally, so `--env local` needs one too. No `queues` here — INGEST is
      // optional and a queue is pointless offline.
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "vev-media" }],
    },
    // `--env preview` is the Cloudflare preview URL (M1 task 6). Ongoing
    // deploys use `versions upload`, not `deploy`, so each one uploads a
    // version without promoting it to the environment's live traffic (see
    // the runbook's bootstrap gotcha for the one-time exception) — as of M2
    // (`preview_urls: false` below) an uploaded, unpromoted version has no
    // URL of its own; `wrangler versions list --env preview` is how to find
    // it. It points
    // at its OWN D1 database (`vev-preview`), never at `vev` (production,
    // reserved for M12) — a preview must never be able to touch production
    // data. Same inheritance rule as `env.local`: `assets` is inherited from
    // the top level and intentionally omitted here; `vars` and
    // `d1_databases` are not inherited and must be repeated.
    "preview": {
      // Same Access application protects vev-preview.0x7.sh in both places —
      // there is only one preview hostname, so this is the same team domain
      // and audience as the top-level vars, repeated because vars are not
      // inherited (see the top-level comment for the confirmation caveats).
      "vars": {
        "ACCESS_AUD": "2751fc6207bcfd7f632e739f25ffd5a12a8325b4fcd8825fb9cbeac9bdf01ffd",
        "ACCESS_TEAM_DOMAIN": "710gs.cloudflareaccess.com",
        // Overwritten at deploy time by `deploy:preview` with the real short
        // commit (`git rev-parse --short HEAD`), so the footer and
        // `/api/health` agree. `dev` here is only the config-file default.
        "GIT_COMMIT": "dev",
        "SOURCE_URL": "https://github.com/yujiym/vev",
        "VEV_MODE": "cloud",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vev-preview",
          "database_id": "bcee626b-7dbd-4456-8fb9-a708583e6e1d",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "vev-media-preview" }],
      "queues": {
        "producers": [{ "binding": "INGEST", "queue": "vev-ingest-preview" }],
        "consumers": [{ "queue": "vev-ingest-preview", "max_batch_size": 1, "max_retries": 2 }],
      },
      // Custom domain for the preview (M1 task 6 follow-up): follows this
      // environment's STABLE deployment — a `versions upload` alone
      // (deploy:preview) never moves it, only `wrangler versions deploy` (or
      // a `deploy`/`triggers deploy`) does. As of M2 (workers_dev/
      // preview_urls false below) this is the ONLY surviving preview URL —
      // see the runbook's Access gotcha. Deliberately NOT vev.0x7.sh: that is
      // the production hostname and the production Worker does not exist yet
      // (M12).
      "routes": [{ "pattern": "vev-preview.0x7.sh", "custom_domain": true }],
      // M1 set both back to `true` after discovering that adding `routes`
      // defaults them to `false` (error 1042 on the workers.dev URL — see the
      // runbook). M2 now sets both to `false` deliberately, for the opposite
      // reason: Access binds to hostnames in the zone and cannot cover
      // `*.workers.dev`, so `vev-preview.host3.workers.dev` served every
      // owner route with no auth at all. Closing it means the only surviving
      // preview URL is the custom domain; per-version `workers.dev` preview
      // URLs (what `versions upload` used to print) stop existing too — the
      // trade §13 requires now that this milestone adds owner routes.
      "workers_dev": false,
      "preview_urls": false,
    },
  },
}
