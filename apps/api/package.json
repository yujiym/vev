{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "pnpm migrate:local && VEV_ASSETS_DIRECTORY=./dev-assets cf dev --mode development",
    "live": "pnpm migrate:local && cf dev --mode development",
    "deploy": "cf deploy",
    "deploy:preview": "GIT_COMMIT=$(git rev-parse --short HEAD) cf workers versions create --mode preview",
    "test": "vp test",
    "db:generate": "drizzle-kit generate",
    "migrate:local": "cf d1 migrations apply 9b91c754-01f5-4399-98a7-bc8b5c9e65e8 --local --persist-to .wrangler/state --dir migrations",
    "migrate:remote": "cf d1 migrations apply 00000000-0000-0000-0000-000000000000 --dir migrations",
    "migrate:preview": "cf d1 migrations apply bcee626b-7dbd-4456-8fb9-a708583e6e1d --dir migrations"
  },
  "dependencies": {
    "@hono/valibot-validator": "^0.6.1",
    "@vev/engines": "workspace:*",
    "@vev/ingest": "workspace:*",
    "@vev/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260928.1",
    "cf": "1.0.0-beta.5",
    "drizzle-kit": "^0.31.11",
    "vitest": "4.1.11"
  }
}
